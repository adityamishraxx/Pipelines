# Copy to .env and fill in real values. Do NOT commit .env.

# ---------------------------------------------------------------------------
# Database — PostgreSQL / Supabase
# ---------------------------------------------------------------------------
# Option A (recommended, e.g. Supabase): a single connection string.
#   Supabase -> Project Settings -> Database -> Connection string -> URI
#   DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# SSL is enabled automatically when DATABASE_URL is set.
DATABASE_URL=

# Option B (local dev): discrete vars (used only when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pipelines
DB_USER=postgres
DB_PASSWORD=
# Force SSL on/off (default: on for DATABASE_URL / non-localhost, off for localhost)
# DB_SSL=true

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# File uploads (relative to backend/)
UPLOAD_DIR=uploads


# Reliance STB/SSO integration. Leave UNSET for the independent app (password login enabled).
# Set to true ONLY when mounting inside the Reliance STB portal.
# JIOAUTIFY=true

NODE_ENV=development

# No admin is seeded. The first time you open the app it shows a one-time
# "Create your admin account" screen. Each business is then added from the UI.
