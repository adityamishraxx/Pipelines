# Loaded by `npm run build`. For the independent deployment, the frontend and the API live on
# DIFFERENT domains (frontend on Vercel, API on Render), so the API base must be the backend's
# public URL. Set it in Vercel -> Project -> Settings -> Environment Variables:
#   REACT_APP_API_BASE = https://your-backend.onrender.com
# Leaving it empty here lets the Vercel env var provide it at build time.
REACT_APP_API_BASE=
