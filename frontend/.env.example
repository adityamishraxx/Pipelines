# Copy to .env if you need to override defaults.

# In dev, `proxy` in package.json forwards /api → http://localhost:4000, so no env var needed.
# In production, either serve the built bundle behind the same domain as the API
# (so /api works via nginx), or set REACT_APP_API_BASE explicitly:
# REACT_APP_API_BASE=https://api.yourcompany.internal
